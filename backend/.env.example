# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# The public address that short links are built on
PUBLIC_URL=http://localhost:3000

# PostgreSQL (Neon)
# Pooled connection: used by the running app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection: used by migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# Redis (any Redis, for example Redis Cloud)
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# Keys the short code scrambler (any random string of 16+ characters)
CODE_SECRET="replace_with_a_long_random_string"

# Set to false to switch rate limiting off (only useful for local experiments)
RATE_LIMIT_ENABLED=true