# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# The public address that short links are built on
PUBLIC_URL=http://localhost:3000

# PostgreSQL (Neon)
# Pooled connection: used by the running app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
# Direct connection: used by migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=verify-full"

# Redis (any Redis, for example Redis Cloud)
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# Keys the short code scrambler (any random string of 16+ characters)
CODE_SECRET="replace_with_a_long_random_string"

# Set to false to switch rate limiting off (only useful for local experiments)
RATE_LIMIT_ENABLED=true

# Protects GET /metrics with "Authorization: Bearer <token>" (16+ characters).
# Without it, /metrics is open in development and switched off in production.
METRICS_TOKEN=
# Optional port for the standalone worker's own /metrics endpoint
WORKER_METRICS_PORT=

# Set to false to switch off the in-memory Bloom filter in front of the redirect cache
BLOOM_FILTER_ENABLED=true

# Only for local experiments: lets webhooks be delivered to localhost and private addresses
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Keeps this copy's Redis keys and channels apart when several copies share one Redis.
# Use dev: on your machine and prod: on the live site.
REDIS_KEY_PREFIX=dev:
# Run the click worker and webhook dispatcher inside the web server (needed on Render's free plan)
RUN_WORKER=false
# How many proxies sit in front of the app (Express "trust proxy"). Measure it with DEBUG_CLIENT_IP.
TRUST_PROXY=1
# Temporarily set to true to see what IP the app thinks you have, at /debug/client-ip
DEBUG_CLIENT_IP=false
